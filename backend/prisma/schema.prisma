generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

//////////////////////////////////////////////////////
// ENUMS
//////////////////////////////////////////////////////

enum Estado {
  ACTIVO
  INACTIVO
}

enum Rol {
  SUPERADMIN
  ADMIN
  SUPERVISOR
  TECNICO
}

enum TipoEstacion {
  POZO
  PLANTA
  ESTANQUE
  SALA_BOMBAS
}

enum TipoDispositivo {
  GATEWAY
  PLC
  SENSOR
}

enum EstadoDispositivo {
  CONECTADO
  DESCONECTADO
  ERROR
}

enum SeveridadAlarma {
  BAJA
  MEDIA
  ALTA
  CRITICA
}

enum EstadoAlarma {
  ACTIVA
  RESUELTA
}

enum TipoComando {
  START_BOMBA
  STOP_BOMBA
  RESET_ALARMA
}

enum EstadoComando {
  PENDIENTE
  ENVIADO
  EJECUTADO
  ERROR
}

enum Plataforma {
  ANDROID
}

enum TipoPlan {
  BASICO
  PROFESIONAL
  EMPRESARIAL
}

enum TipoHistorialTenant {
  ACTIVACION
  DESACTIVACION
  CAMBIO_PLAN
  CAMBIO_ADMIN
}

enum TipoSensorScada {
  NIVEL
  CAUDAL
  PRESION
  CLORO
  TURBIDEZ
  ENERGIA
  ESTADO
  ALARMA
  OTRO
}

//////////////////////////////////////////////////////
// MODELOS BASE APP / SAAS
//////////////////////////////////////////////////////

model Tenant {
  id        Int      @id @default(autoincrement())
  planId    Int?
  nombre    String   @unique
  estado    Estado   @default(ACTIVO)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plan      Plan?             @relation(fields: [planId], references: [id])
  usuarios  Usuario[]
  recintos  Recinto[]
  historial HistorialTenant[]

  // Capa SCADA / Telemetría
  sensores        SensorScada[]
  registrosScada  RegistroScada[]
  estadosActuales EstadoActualScada[]
  alarmas         Alarma[]
  comandos        Comando[]

  @@index([estado])
}

model Usuario {
  id           Int      @id @default(autoincrement())
  tenantId     Int?
  nombre       String
  email        String   @unique
  passwordHash String
  rol          Rol
  estado       Estado   @default(ACTIVO)
  isPrimary    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant            Tenant?            @relation(fields: [tenantId], references: [id])
  comandos          Comando[]
  dispositivosMovil DispositivoMovil[]
  historialTenants  HistorialTenant[]

  @@index([tenantId])
  @@index([rol])
  @@index([estado])
}

model Recinto {
  id          Int      @id @default(autoincrement())
  tenantId    Int
  codigo      String
  nombre      String
  ubicacion   String?
  descripcion String?
  estado      Estado   @default(ACTIVO)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant          Tenant              @relation(fields: [tenantId], references: [id])
  estaciones      Estacion[]
  sensores        SensorScada[]
  registrosScada  RegistroScada[]
  estadosActuales EstadoActualScada[]
  alarmas         Alarma[]
  comandos        Comando[]

  @@unique([tenantId, codigo])
  @@index([tenantId, estado])
}

model Estacion {
  id          Int          @id @default(autoincrement())
  recintoId   Int
  codigo      String
  nombre      String
  tipo        TipoEstacion
  descripcion String?
  estado      Estado       @default(ACTIVO)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  recinto         Recinto             @relation(fields: [recintoId], references: [id])
  dispositivos    Dispositivo[]
  sensores        SensorScada[]
  registrosScada  RegistroScada[]
  estadosActuales EstadoActualScada[]
  alarmas         Alarma[]
  comandos        Comando[]

  @@unique([recintoId, codigo])
  @@index([recintoId, estado])
  @@index([tipo])
}

model Dispositivo {
  id             Int               @id @default(autoincrement())
  estacionId     Int
  codigo         String
  azureDeviceId  String?           @unique
  nombre         String
  tipo           TipoDispositivo
  estado         EstadoDispositivo @default(DESCONECTADO)
  ultimaConexion DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  estacion        Estacion            @relation(fields: [estacionId], references: [id])
  sensores        SensorScada[]
  registrosScada  RegistroScada[]
  estadosActuales EstadoActualScada[]
  alarmas         Alarma[]
  comandos        Comando[]

  @@unique([estacionId, codigo])
  @@index([estacionId, estado])
  @@index([tipo])
}

//////////////////////////////////////////////////////
// MODELOS SCADA / TELEMETRÍA
//////////////////////////////////////////////////////

model SensorScada {
  id            Int             @id @default(autoincrement())
  tenantId      Int
  recintoId     Int
  estacionId    Int
  dispositivoId Int
  codigo        String
  nombre        String
  tipo          TipoSensorScada @default(OTRO)
  metric        String
  unit          String?
  descripcion   String?
  estado        Estado          @default(ACTIVO)

  // Umbrales opcionales para pintar OK / WARNING / CRÍTICO desde backend
  warningMin  Float?
  warningMax  Float?
  criticalMin Float?
  criticalMax Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant          Tenant              @relation(fields: [tenantId], references: [id])
  recinto         Recinto             @relation(fields: [recintoId], references: [id])
  estacion        Estacion            @relation(fields: [estacionId], references: [id])
  dispositivo     Dispositivo         @relation(fields: [dispositivoId], references: [id])
  registrosScada  RegistroScada[]
  estadosActuales EstadoActualScada[]
  alarmas         Alarma[]

  @@unique([dispositivoId, codigo])
  @@index([tenantId, recintoId, estacionId])
  @@index([dispositivoId, metric])
  @@index([estado])
}

model RegistroScada {
  id String @id @default(uuid())

  // ID externo del mensaje recibido desde gateway/API/IoT.
  // Permite evitar duplicados si el mismo paquete se reintenta.
  externalMessageId String? @unique

  // Claves foráneas principales para segmentación SaaS + SCADA
  tenantId      Int
  recintoId     Int?
  estacionId    Int?
  dispositivoId Int?
  sensorId      Int?

  // Identificadores originales del JSON recibido
  messageType String  @default("telemetry")
  tenantCode  String
  siteCode    String?
  stationCode String?
  deviceCode  String?
  gatewayCode String?
  plcCode     String?
  sensorCode  String?

  // Dato normalizado para consulta rápida
  metric       String
  unit         String?
  valueFloat   Float?
  valueInt     Int?
  valueBoolean Boolean?
  valueText    String?
  valueJson    Json?

  // Datos operacionales complementarios
  quality  String?
  status   String?
  sequence BigInt?

  // Fechas
  capturedAt DateTime
  ingestedAt DateTime @default(now())

  // JSON completo original. Sirve para auditoría, reproceso y compatibilidad futura.
  rawPayload Json

  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  recinto     Recinto?     @relation(fields: [recintoId], references: [id])
  estacion    Estacion?    @relation(fields: [estacionId], references: [id])
  dispositivo Dispositivo? @relation(fields: [dispositivoId], references: [id])
  sensor      SensorScada? @relation(fields: [sensorId], references: [id])
  alarmas     Alarma[]

  @@index([tenantId, capturedAt])
  @@index([tenantId, recintoId, capturedAt])
  @@index([tenantId, recintoId, estacionId, capturedAt])
  @@index([dispositivoId, metric, capturedAt])
  @@index([sensorId, capturedAt])
  @@index([tenantCode, siteCode, deviceCode, capturedAt])
}

model EstadoActualScada {
  id            Int @id @default(autoincrement())
  tenantId      Int
  recintoId     Int
  estacionId    Int
  dispositivoId Int
  sensorId      Int

  metric       String
  unit         String?
  valueFloat   Float?
  valueInt     Int?
  valueBoolean Boolean?
  valueText    String?
  valueJson    Json?
  status       String   @default("OK")
  quality      String?

  capturedAt DateTime
  updatedAt  DateTime @updatedAt
  rawPayload Json?

  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  recinto     Recinto     @relation(fields: [recintoId], references: [id])
  estacion    Estacion    @relation(fields: [estacionId], references: [id])
  dispositivo Dispositivo @relation(fields: [dispositivoId], references: [id])
  sensor      SensorScada @relation(fields: [sensorId], references: [id])

  @@unique([sensorId, metric])
  @@index([tenantId, recintoId])
  @@index([dispositivoId])
  @@index([status])
}

//////////////////////////////////////////////////////
// ALARMAS / COMANDOS / PUSH
//////////////////////////////////////////////////////

model Alarma {
  id            Int     @id @default(autoincrement())
  tenantId      Int?
  recintoId     Int?
  estacionId    Int
  dispositivoId Int?
  sensorId      Int?
  registroId    String?

  tipo        String
  severidad   SeveridadAlarma
  mensaje     String
  estado      EstadoAlarma    @default(ACTIVA)
  fechaInicio DateTime        @default(now())
  fechaCierre DateTime?

  tenant      Tenant?        @relation(fields: [tenantId], references: [id])
  recinto     Recinto?       @relation(fields: [recintoId], references: [id])
  estacion    Estacion       @relation(fields: [estacionId], references: [id])
  dispositivo Dispositivo?   @relation(fields: [dispositivoId], references: [id])
  sensor      SensorScada?   @relation(fields: [sensorId], references: [id])
  registro    RegistroScada? @relation(fields: [registroId], references: [id])

  @@index([tenantId, estado])
  @@index([estacionId, estado])
  @@index([sensorId, estado])
}

model Comando {
  id             Int           @id @default(autoincrement())
  tenantId       Int?
  recintoId      Int?
  estacionId     Int?
  dispositivoId  Int
  usuarioId      Int
  tipo           TipoComando
  estado         EstadoComando @default(PENDIENTE)
  payload        Json?
  respuesta      String?
  fechaSolicitud DateTime      @default(now())
  fechaRespuesta DateTime?

  tenant      Tenant?     @relation(fields: [tenantId], references: [id])
  recinto     Recinto?    @relation(fields: [recintoId], references: [id])
  estacion    Estacion?   @relation(fields: [estacionId], references: [id])
  dispositivo Dispositivo @relation(fields: [dispositivoId], references: [id])
  usuario     Usuario     @relation(fields: [usuarioId], references: [id])

  @@index([tenantId, estado])
  @@index([dispositivoId, estado])
  @@index([usuarioId])
}

model DispositivoMovil {
  id         Int        @id @default(autoincrement())
  usuarioId  Int
  token      String
  plataforma Plataforma
  activo     Boolean    @default(true)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@index([usuarioId, activo])
}

model Plan {
  id          Int      @id @default(autoincrement())
  nombre      TipoPlan @unique
  descripcion String?
  estado      Estado   @default(ACTIVO)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenants        Tenant[]
  historialAntes HistorialTenant[] @relation("PlanAntes")
  historialNuevo HistorialTenant[] @relation("PlanNuevo")
}

model HistorialTenant {
  id          Int                 @id @default(autoincrement())
  tenantId    Int
  usuarioId   Int?
  tipo        TipoHistorialTenant
  estadoAntes Estado?
  estadoNuevo Estado?
  planAntesId Int?
  planNuevoId Int?
  nota        String
  createdAt   DateTime            @default(now())

  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  usuario   Usuario? @relation(fields: [usuarioId], references: [id])
  planAntes Plan?    @relation("PlanAntes", fields: [planAntesId], references: [id])
  planNuevo Plan?    @relation("PlanNuevo", fields: [planNuevoId], references: [id])

  @@index([tenantId, createdAt])
  @@index([usuarioId])
}
